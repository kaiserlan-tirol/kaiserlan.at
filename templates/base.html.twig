<!DOCTYPE html>
<html lang="de">
    <head>
        <meta charset="UTF-8">
        {#
        {% if app.request.server.get('SERVER_NAME') != 'www.kaiserlan.at' %}
        <meta name="robots" content="noindex, nofollow">
        {% endif %}
        #}
        <meta name="server_name" content="{{ app.request.server.get('SERVER_NAME') }}">
        <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
        <meta http-equiv="cache-control" content="no-cache"/>
        {% block favicon %}<link rel="shortcut icon" href="/favicon.ico" />
        <link rel="icon" type="image/svg+xml" href="/favicon-64x64.svg">
        <link rel="alternate icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
        <link rel="mask-icon" href="/favicon-64x64.svg" color="#000000">
        {% endblock %}
        {# <link rel="manifest" href="/site.webmanifest"> #}
        <title>{% block title %}{{ settings.get('site.title') }}{% endblock %}</title>
        {% block stylesheets %}
            {{ encore_entry_link_tags('app') }}
        {% endblock %}
    </head>
    <body>
        {% block body %}{% endblock %}
        {% block javascripts %}
            {{ encore_entry_script_tags('app') }}
            <!-- Google tag (gtag.js) -->
            <script async src="https://www.googletagmanager.com/gtag/js?id=G-MJ9574KJE7"></script>
            <script>
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            gtag('js', new Date());

            gtag('config', 'G-MJ9574KJE7');
            </script>
        {% endblock %}
    </body>
</html>
