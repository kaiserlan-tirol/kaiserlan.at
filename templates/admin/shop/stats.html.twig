{% extends 'admin/adminBase.html.twig' %}

{% block title %}Ticket Statistik - KLMS - Admin{% endblock %}
{% block siteheading %}<i class="fas fa-chart-bar"></i> Ticket Statistik{% endblock %}
{% block main %}
    <div class="row">
        <div class="col-12">
            <div class="mb-2">
                <a href="{{ path('admin_shop') }}" class="btn btn-sm btn-secondary"><i class="fas fa-chevron-left"></i></a>
                <a href="{{ path('admin_shop_stats', {'paid': paidOnly ? 0 : 1}) }}" class="btn btn-sm btn-primary">
                    {% if paidOnly %}Bestellt &amp; bezahlt anzeigen{% else %}Nur bezahlt anzeigen{% endif %}
                </a>
            </div>
            <div class="card">
                <table class="table table-striped">
                    <thead>
                    <tr>
                        <th>{% if paidOnly %}Bezahlte Bestellungen{% else %}Offene &amp; bezahlte Bestellungen{% endif %}</th>
                        <th class="text-center" style="width: 8em;">Count</th>
                        <th class="text-right" style="width: 10em;">Preis</th>
                        <th class="text-right" style="width: 12em;">Summe</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for row in stats.rows %}
                        <tr>
                            <td>{{ row.label }}</td>
                            <td class="text-center">{{ row.count }}</td>
                            <td class="text-right">{{ (row.price/100) | format_currency('EUR') }}</td>
                            <td class="text-right">{{ (row.revenue/100) | format_currency('EUR') }}</td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="4" class="text-center">Keine Bestellungen vorhanden.</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                    <tfoot>
                    <tr class="table-active">
                        <th colspan="3" class="text-right">Total</th>
                        <th class="text-right">{{ (stats.total/100) | format_currency('EUR') }}</th>
                    </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
{% endblock %}
