{% extends 'admin/adminBase.html.twig' %}

{% block title %}Catering - KLMS - Admin{% endblock %}
{% block siteheading %}<i class="fas fa-utensils"></i> Catering{% endblock %}
{% block main %}
    <div class="row">
        <div class="col-12">
            <div class="mb-2">
                <a href="{{ path('admin_catering_order_create') }}" class="btn btn-sm btn-success" data-toggle="ajaxModal">
                    <i class="fas fa-plus"></i> Bestellung erfassen
                </a>
                <a href="{{ path('admin_catering_product') }}" class="btn btn-sm btn-secondary">
                    <i class="fas fa-utensils"></i> Produkte verwalten
                </a>
                <a href="{{ path('admin_catering_credit_management') }}" class="btn btn-sm btn-warning">
                    <i class="fas fa-wallet"></i> Guthaben verwalten
                </a>
                <a href="{{ path('admin_catering_pizza') }}" class="btn btn-sm btn-info">
                    <i class="fas fa-pizza-slice"></i> Pizzabestellungen
                </a>
                <a href="{{ path('admin_catering_stats') }}" class="btn btn-sm btn-primary">
                    <i class="fas fa-chart-bar"></i> Statistik
                </a>
                <a href="{{ path('admin_catering_order_export') }}" class="btn btn-sm btn-primary">
                    <i class="fas fa-download"></i> Export CSV
                </a>
            </div>
            <div class="card">
                <table class="table table-striped admin-data-table" data-order="[[ 2, &quot;desc&quot; ]]">
                    <thead>
                        <tr>
                            <th class="text-nowrap w-1">&#8470;</th>
                            <th class="w-25">Besteller</th>
                            <th class="w-25">Datum</th>
                            <th class="text-nowrap w-1">Artikel</th>
                            <th>Betrag</th>
                            <th>Status</th>
                            <th class="text-nowrap w-1" data-orderable="false" data-searchable="false">Aktionen</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for order in orders %}
                        <tr>
                            <td class="text-center">{{ order.id }}</td>
                            <td data-order="{{ order.orderer | username }}">{{ order.orderer | username }}</td>
                            <td data-order="{{ order.createdAt | date('U') }}">{{ order.createdAt | date('d.m.y H:i') }}</td>
                            <td class="text-center">{{ order.totalItems }}</td>
                            {% set total = order.calculateTotal %}
                            <td class="text-right" data-order="{{ total }}">{{ (total/100) | format_currency('EUR') }}</td>
                            <td>
                                {% if order.isRefunded or order.isCanceled %}
                                    <span class="badge badge-secondary">Storniert</span>
                                {% else %}
                                    <span class="badge badge-success">Erledigt</span>
                                {% endif %}
                            </td>
                            <td>
                                <div class="btn-group">
                                    <a class="btn btn-sm btn-outline-primary text-nowrap" href="{{ path('admin_catering_show', {'id': order.id}) }}">
                                        <i class="fas fa-cart-shopping"></i> Details
                                    </a>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %}
