{% extends 'admin/adminBase.html.twig' %}

{% block title %}Catering Produkt bearbeiten - KLMS - Admin{% endblock %}
{% block siteheading %}<i class="fas fa-utensils"></i> Catering Produkt bearbeiten{% endblock %}
{% block main %}
<div class="container-fluid">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card">
                <div class="card-header">
                    <h4 class="card-title mb-0">
                        {% if product.id %}
                            Catering Produkt bearbeiten
                        {% else %}
                            Neues Catering Produkt
                        {% endif %}
                    </h4>
                </div>
                
                {{ form_start(form) }}
                <div class="card-body">
                    <div class="form-group">
                        {{ form_label(form.name) }}
                        {{ form_widget(form.name, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.name) }}
                    </div>
                    
                    <div class="form-group">
                        {{ form_label(form.description) }}
                        {{ form_widget(form.description, {'attr': {'class': 'form-control', 'rows': 3}}) }}
                        {{ form_errors(form.description) }}
                    </div>
                    
                    <div class="form-row">
                        <div class="form-group col-md-6">
                            {{ form_label(form.price) }}
                            {{ form_widget(form.price, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(form.price) }}
                        </div>
                        <div class="form-group col-md-6">
                            {{ form_label(form.productCode) }}
                            {{ form_widget(form.productCode, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(form.productCode) }}
                        </div>
                    </div>
                    
                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <div class="form-check">
                                {{ form_widget(form.active, {'attr': {'class': 'form-check-input'}}) }}
                                {{ form_label(form.active, null, {'label_attr': {'class': 'form-check-label'}}) }}
                            </div>
                            {{ form_errors(form.active) }}
                        </div>
                        <div class="form-group col-md-6">
                            <div class="form-check">
                                {{ form_widget(form.includedInFlat, {'attr': {'class': 'form-check-input'}}) }}
                                {{ form_label(form.includedInFlat, null, {'label_attr': {'class': 'form-check-label'}}) }}
                            </div>
                            {{ form_errors(form.includedInFlat) }}
                        </div>
                    </div>
                    
                    <div class="form-group">
                        {{ form_label(form.sortIndex) }}
                        {{ form_widget(form.sortIndex, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.sortIndex) }}
                    </div>
                </div>
                
                <div class="card-footer">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save"></i> Speichern
                    </button>
                    <a href="{{ path('admin_catering_product') }}" class="btn btn-secondary">
                        <i class="fas fa-times"></i> Abbrechen
                    </a>
                    
                    {% if product is defined and product.id %}
                        <div class="float-right">
                            <form method="post" action="{{ path('admin_catering_product_delete', {'id': product.id}) }}" style="display: inline;" onsubmit="return confirm('Wirklich löschen?')">
                                <input type="hidden" name="_token" value="{{ csrf_token(csrf_token) }}">
                                <button type="submit" class="btn btn-danger">
                                    <i class="fas fa-trash"></i> Löschen
                                </button>
                            </form>
                        </div>
                    {% endif %}
                </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
