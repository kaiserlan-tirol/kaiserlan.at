{% extends 'admin/adminBase.html.twig' %}

{% block title %}Einzahlungen - KLMS - Admin{% endblock %}
{% block siteheading %}<i class="fas fa-ticket"></i> Tickets{% endblock %}
{% block main %}
    <div class="row mb-4">
        <div class="col-auto pr-0">
            {{ form_start(form_new) }}
                <button type="submit" class="btn btn-sm btn-success" id="new-empty">
                    <i class="fas fa-plus"></i> Ticket anlegen
                </button>
            {% do form_new.user.setRendered() %}
            {{ form_end(form_new) }}
        </div>
        <div class="col-auto">
            <button class="btn btn-sm btn-success" data-toggle="modal" data-target="#newModal" id="new">
                <i class="fas fa-plus"></i> Gamer anmelden
            </button>

            <a class="btn btn-success" href="?dogtags=1&unpaid=1">
                <i class="fas fa-table"></i> DogTags
            </a>
        </div>
        <div class="col-auto ml-auto">
            <div class="input-group">
                <div class="input-group-prepend">
                    <span class="input-group-text"><i class="fas fa-filter"></i></span>
                </div>
                <select class="form-control" id="addon-filter" onchange="filterByAddon()">
                    <option value="">Alle Tickets</option>
                    {% for addon in addons %}
                        <option value="{{ addon.id }}" {% if selectedAddon == addon.id %}selected{% endif %}>
                            Tickets mit: {{ addon.name }}
                        </option>
                    {% endfor %}
                </select>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-12">
            <div class="card">
                <table id="GamerTable" class="table table-striped admin-data-table" data-order='[[2, "asc"]]'
                >
                    <thead>
                    <tr>
                        <th>&#8470;</th>
                        <th>Code</th>
                        <th><i class="fas fa-euro-sign"></i></th>
                        <th>Erstellt</th>
                        <th>Eingelöst</th>
                        <th class="w-25">Nickname</th>
                        <th class="w-25">Name</th>
                        <th>Status</th>
                        <th>Sitzplatz</th>
                        <th>Registriert</th>
                        <th
                                class="text-nowrap w-1"
                                data-orderable="false"
                                data-searchable="false"
                        >
                            Aktionen
                        </th>
                    </tr>
                    </thead>
                    <tbody>
                    {% set dateformat = "d.m.Y H:i" %}
                    {% for ticket in tickets %}
                        <tr>
                            <td class="text-nowrap text-monospace text-right">{{ ticket.id }}</td>
                            <td class="text-nowrap text-monospace">{{ ticket.code }}</td>
                            <td>{% if ticket.shopOrderPosition %} <span class="badge badge-secondary" title="Gekauft"><i class="fas fa-euro-sign"></i></span>{% endif %}</td>
                            <td data-order="{{ ticket.createdAt | date('U') }}">{{ ticket.createdAt | date(dateformat) }}</td>
                        {% if ticket.redeemed %}
                            <td data-order="{{ ticket.redeemedAt | date('U') }}">{{ ticket.redeemedAt | date(dateformat) }}</td>
                            {% set user = users[ticket.redeemer.toString()] %}
                            <td data-order="{{ user.nickname }}">
                                {% for clan in user.clans %}
                                    <a class="badge badge-pill badge-primary" href="{{ path('admin_clan_show', {'uuid' : clan.uuid }) }}" data-toggle="ajaxModal">{{clan.clantag }}</a>
                                {% endfor %}
                                <a href="{{ path('admin_user_show', {'uuid' : user.uuid }) }}" data-toggle="ajaxModal">{{ user.nickname }}</a>
                            </td>
                            <td>{{ user.firstname }} {{ user.surname }}</td>
                        {% else %}
                            <td></td>
                            <td></td>
                            <td></td>
                        {% endif %}
                            <td class="text-center">
                                {% if ticket.isRedeemed %}
                                    {% if ticket.isPunched %}
                                        <span class="badge badge-success">Checked-In</span>
                                    {% else %}
                                        <span class="badge badge-primary">Eingel&ouml;st</span>
                                    {% endif %}

                                    {% set user = ticket.redeemer | user %}
                                    {% if user is age_below(18) %}
                                        <span class="badge badge-danger">U18</span>
                                    {% endif %}
                                {% else %}
                                    <span class="badge badge-secondary">Offen</span>
                                {% endif %}
                            </td>
                            <td class="text-center">
                                {% if ticket.isRedeemed %}
                                    {% if ticket.redeemer is not seated_user %}
                                        <span class="badge badge-danger">n.v.</span>
                                    {% else %}
                                        <span class="badge badge-secondary"><i class="fa-solid fa-chair"></i> {{ ticket.redeemer | seat }}</span>
                                    {% endif %}
                                {% endif %}
                            </td>
                            <td>
                                {{ ticket.createdAt|date('Y-m-d') }}
                            </td>
                            <td>
                                <a class="btn btn-sm btn-outline-dark text-nowrap" data-toggle="ajaxModal" href="{{ path('admin_payment_show', {'id' : ticket.id}) }}">
                                    <i class="fas fa-ticket"></i> Details
                                </a>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    {% include 'admin/payment/modal.add.html.twig' %}
    
    <script>
        function filterByAddon() {
            const select = document.getElementById('addon-filter');
            const addonId = select.value;
            const url = new URL(window.location);
            
            if (addonId) {
                url.searchParams.set('addon', addonId);
            } else {
                url.searchParams.delete('addon');
            }
            
            window.location.href = url.toString();
        }
    </script>
{% endblock %}
