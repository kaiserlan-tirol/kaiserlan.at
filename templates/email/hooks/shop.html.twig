{% extends 'email/design/standard.html.twig' %}

{% block main %}
{% set text = settings.get('email.shop.text') %}
{% set org = settings.get('site.organisation') %}
<h1>Bestellung #{{ order.id }}</h1>
<p>
{% if text is empty %}Danke für deine Bestellung bei {{ org }}.{% else %}{{ text }}{% endif %}
</p>
<div class="my-2">
{% include 'site/shop/_order.html.twig' %}
</div>
<div class="my-2">
{% if showPaymentInfo | default(false) %}
Bitte bezahle <b>{{ (order.calculateTotal() / 100) | format_currency('EUR') }}</b>
unter der Angabe <b>Bestellnummer {{ order.id }}</b>
{% if settings.get('lan.signup.payment_details') %}
an:
<div class="border p-2 m-1">{{ settings.get('lan.signup.payment_details') | raw }}</div>
{% else %}
<div class="border p-2 m-1">
    <p style="outline: 0px; user-select: none;">&nbsp;</p>
    <p style="outline: 0px; user-select: none;"><strong>Zahlung per Paypal (an Freunde senden):</strong></p>
    <p style="outline: 0px; user-select: none;">Jetzt bezahlen: <a href="https://paypal.me/kaiserlantirol/{{ (order.calculateTotal() / 100) }}EUR" target="_blank" rel="noopener">paypal.me/kaiserlantirol/{{ (order.calculateTotal() / 100) }}EUR</a></p>
    <p style="outline: 0px; user-select: none;">Oder an verein@kaiserlan.at</p>
    <p style="outline: 0px; user-select: none;"><strong>Zahlung per &Uuml;berweisung</strong></p>
    <p style="outline: 0px; user-select: none;">Empf&auml;nger: Markus Edenhauser<br />Neues Vereinskonto bei Revolut. Litauen, LT stimmt ;-)<br />IBAN: LT86 3250 0187 3587 6769<br />BIC: REVOLT21<br />Verwendungszweck: Dein Benutzer-/Gamertag</p>
    <p style="outline: 0px; user-select: none;">&nbsp;</p>
    <p style="outline: 0px; user-select: none;">Banking QR-Code:<br />
    <img 
        src="data:image/png;base64,{{ qr_code_data_uri('BCD\n001\n1\nSCT\nREVOLT21\nEdenhauser KaiserLAN\nLT863250018735876769\nEUR' ~ (order.calculateTotal() / 100) ~ '\n\nOrder ' ~ order.id ~ ', Eintritt')|replace({'data:image/png;base64,': ''}) }}" 
        alt="QR-Code für Überweisung" 
        title="Scan mit Banking-App für einfache Überweisung"
    />
    </p>
    <p style="outline: 0px; user-select: none;">&nbsp;</p>
</div>
{% endif %}
{% elseif showPaymentSuccess | default(false) %}
{% if order.calculateTotal > 0 %}
Wir haben dein Geld erhalten und deine Bestellung wurde bearbeitet.
{% else %}
Deine Bestellung wurde bearbeitet.
{% endif %}
{% if order.countTickets >= 1 %}
Dein Eintritt wurde freigeschaltet. Solltest du noch keinen Sitzplatz reserviert haben, mach das <a href="{{ url('seatmap') }}">hier</a>!
{% if order.countTickets > 1 %} Die Codes für die weiteren Tickets findest du oben. Gib diese an deine Freunde weiter.
In der <a href="{{ url('shop_orders') }}">Bestellübersicht</a> kannst du sehen, wer welches Ticket aktiviert hat.{% endif %}
{% endif %}
{% endif %}
</div>
<p></p>
{% include 'email/components/greetings.html.twig' %}
{% endblock %}
