{% extends 'site/catering/kassa/base.html.twig' %}

{% block title %}Produkte wählen - KaiserLAN Kassa{% endblock %}

{% block content %}
<div id="products-page">
    <!-- User info header -->
    <div style="background: linear-gradient(135deg, rgb(0, 123, 230) 0%,#4dacff 100%); color: white; padding: 20px; border-radius: 15px; margin-bottom: 30px; text-align: center;">
        <h3 style="margin: 0; font-size: 1.8rem; display: flex; align-items: center; justify-content: space-between;">
          <span>
            <i class="fas fa-user-circle" style="margin-right: 10px;"></i>
            Willkommen, {{ user.nickname }}!
            </span>
            <span style="margin: 0; font-size: 1.2rem; opacity: 0.9;">
                <i class="fas fa-wallet" style="margin-right: 8px;"></i>
                Guthaben: <strong>{{ (current_credit/100) | format_currency('EUR') }}</strong>
            </span>
        </h3>
    </div>

    <!-- Combined Products List -->
    <div style="margin-bottom: 40px;">

        {% if products|length > 0 or addon_products|length > 0 %}
        <div class="product-list">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Produkt</th>
                        <th>Preis</th>
                        <th>Menge</th>
                    </tr>
                </thead>
                <tbody>
                    {# First display addon products #}
                    {% for product in addon_products %}
                        <tr class="product-row addon-product" data-product-id="{{ product.id }}" data-price="0" data-original-price="{{ product.price }}">
                            <td>
                                <strong>{{ product.name }}</strong>
                                {#
                                {% if product.description %}
                                    <div class="small text-muted">{{ product.description }}</div>
                                {% endif %}
                                <div class="addon-badges">
                                    {% for addon in product.includedInAddons %}
                                        {% if addon in user_addons %}
                                            <span class="badge bg-warning">{{ addon.name }}</span>
                                        {% endif %}
                                    {% endfor %}
                                </div>
                                #}
                            </td>
                            <td>
                                <span class="free-price">Kostenlos</span>
                            </td>
                            <td>
                                <div class="product-controls">
                                    <button class="btn btn-outline-secondary btn-quantity btn-decrease">-</button>
                                    <span class="quantity mx-3">0</span>
                                    <button class="btn btn-outline-secondary btn-quantity btn-increase">+</button>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                    
                    {# Then display regular products #}
                    {% for product in products %}
                        <tr class="product-row" data-product-id="{{ product.id }}" data-price="{{ product.price }}">
                            <td>
                                <strong>{{ product.name }}</strong>
                                {% if product.description %}
                                    <div class="small text-muted">{{ product.description }}</div>
                                {% endif %}
                            </td>
                            <td>
                                {{ (product.price/100) | format_currency('EUR') }}
                            </td>
                            <td>
                                <div class="product-controls">
                                    <button class="btn btn-outline-secondary btn-quantity btn-decrease">-</button>
                                    <span class="quantity mx-3">0</span>
                                    <button class="btn btn-outline-secondary btn-quantity btn-increase">+</button>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% else %}
        <div style="text-align: center; padding: 40px; color: #666;">
            <i class="fas fa-shopping-basket" style="font-size: 4rem; margin-bottom: 20px; opacity: 0.5;"></i>
            <p style="font-size: 1.3rem;">Derzeit sind keine Produkte verfügbar.</p>
        </div>
        {% endif %}
    </div>

    <!-- Cart Summary -->
    <div id="cart-summary" style="position: sticky; bottom: 0; background: white; padding: 20px; border-radius: 15px 15px 0 0; box-shadow: 0 -4px 20px rgba(0,0,0,0.1); margin: 0 -30px -30px -30px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; gap: 40px;">
          <div>
              <p style="font-size: 1.2rem; color: #666; word-wrap: no-wrap;">Artikel: <span id="cart-count" style="font-size: 1.3rem; font-weight: 600; color: #333;">0</span></p>
          </div>
          <button id="checkout-btn" class="btn-kassa" style="width: 60%; margin-bottom: 15px;" disabled>
              <i class="fas fa-shopping-cart" style="margin-right: 15px;"></i>
              Jetzt kaufen
          </button>
        </div>
        <div class="kassa-navigation" style="margin-top: 0;">
            <a href="{{ path('catering_kassa_index') }}" class="btn-kassa btn-kassa-danger">
                <i class="fas fa-times"></i>
                Abbrechen
            </a>
            <a href="{{ path('catering_kassa_payment', {userId: user.uuid}) }}" class="btn-kassa btn-kassa-secondary">
                <i class="fas fa-wallet"></i>
                Kontostand
            </a>
        </div>
    </div>
</div>

<!-- Toast container for notifications -->
<div class="toast-container" id="toast-container"></div>

<style>
.product-list {
    margin-bottom: 30px;
}

.product-list table {
    border-collapse: separate;
    border-spacing: 0;
    width: 100%;

}

.product-list th {
    background-color: #f8f9fa;
    padding: 12px 15px;
    font-weight: 600;
    color: #333;
    text-align: left;
}

.product-row {
    transition: all 0.2s ease;
    font-size: 1.4rem;
}

.product-row td {
  vertical-align: middle;
  padding: 8px 12px 6px 12px;
}

.product-row td:first-child {
    width: 60%;
}
.product-row td:nth-child(2) {
    width: 20%;
}

.product-row:hover {
    background-color: #f8f9fa;
}

.product-row.table-success {
    background-color: #d4edda !important;
}

.product-row.table-success:hover {
    background-color: #c3e6cb !important;
}

.product-row.addon-product {
    background-color: #fff3cd;
}

.product-row.addon-product:hover {
    background-color: #ffeeba;
}

.product-row.addon-product.table-success {
    background-color: #d1ecf1 !important;
}

.product-row.addon-product.table-success:hover {
    background-color: #bee5eb !important;
}

.product-controls {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 15px;
}

.btn-quantity {
    min-width: 50px;
    font-size: 1.5rem;
    padding: 0.4rem 0.8rem;
    height: 50px;
    width: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
}

.quantity {
    font-size: 2rem;
    font-weight: 600;
    color: #333;
    text-align: center;
    min-width: 40px;
}

.addon-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    margin-top: 5px;
}

.free-price {
    color: #28a745;
}

.original-price {
    color: #666;
    font-size: 0.9rem;
    text-decoration: line-through;
    opacity: 0.7;
}

/* Toast notification styles */
.toast-container {
    position: fixed;
    bottom: 30px;
    right: 30px;
    z-index: 9999;
}

.toast {
    background: rgba(0, 0, 0, 0.85);
    color: white;
    padding: 15px 25px;
    border-radius: 8px;
    margin-bottom: 10px;
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
    display: flex;
    align-items: center;
    animation: slideIn 0.3s, fadeOut 0.5s 9.5s;
    max-width: 350px;
    opacity: 0;
    pointer-events: none;
}

.toast.show {
    opacity: 1;
    pointer-events: auto;
}

.toast-icon {
    margin-right: 15px;
    font-size: 1.2rem;
    color: #ffcc00;
}

.toast-content {
    flex: 1;
}

.toast-title {
    font-weight: 600;
    margin-bottom: 5px;
    font-size: 1.1rem;
}

.toast-body {
    font-size: 0.9rem;
    opacity: 0.9;
}

.toast-action {
    background: #007be6;
    color: white;
    border: none;
    padding: 5px 15px;
    border-radius: 4px;
    margin-top: 8px;
    cursor: pointer;
    font-weight: 500;
    font-size: 0.9rem;
}

@keyframes slideIn {
    from {
        transform: translateX(100%);
        opacity: 0;
    }
    to {
        transform: translateX(0);
        opacity: 1;
    }
}

@keyframes fadeOut {
    from {
        opacity: 1;
    }
    to {
        opacity: 0;
    }
}

</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const cart = {};
    const userCredit = {{ current_credit }};
    
    // Session timeout management
    let inactivityTimer;
    let warningToastTimer;
    const sessionTimeout = 2 * 60 * 1000; // 2 minutes
    const warningTime = 10 * 1000; // Show warning 10 seconds before timeout
    
    // Function to show toast notification
    function showToast(title, message, actionText = null, actionCallback = null) {
        const toastContainer = document.getElementById('toast-container');
        
        // Create toast element
        const toast = document.createElement('div');
        toast.className = 'toast';
        
        // Create toast content
        let toastHTML = `
            <div class="toast-icon">
                <i class="fas fa-clock"></i>
            </div>
            <div class="toast-content">
                <div class="toast-title">${title}</div>
                <div class="toast-body">${message}</div>
        `;
        
        // Add action button if provided
        if (actionText && actionCallback) {
            toastHTML += `<button class="toast-action">${actionText}</button>`;
        }
        
        toastHTML += `</div>`;
        toast.innerHTML = toastHTML;
        
        // Add to container
        toastContainer.appendChild(toast);
        
        // Action button click handler
        if (actionText && actionCallback) {
            const actionButton = toast.querySelector('.toast-action');
            if (actionButton) {
                actionButton.addEventListener('click', () => {
                    actionCallback();
                    removeToast();
                });
            }
        }
        
        // Show toast with animation
        setTimeout(() => {
            toast.classList.add('show');
        }, 10);
        
        // Function to remove the toast
        function removeToast() {
            toast.classList.remove('show');
            setTimeout(() => {
                if (toast.parentNode === toastContainer) {
                    toastContainer.removeChild(toast);
                }
            }, 300);
        }
        
        // Auto remove after 10 seconds if not closed already
        setTimeout(removeToast, 10000);
        
        return {
            close: removeToast
        };
    }
    
    function resetInactivityTimer() {
        // Clear existing timers
        clearTimeout(inactivityTimer);
        clearTimeout(warningToastTimer);
        
        // Set new timers
        warningToastTimer = setTimeout(() => {
            const toast = showToast(
                "Session läuft ab", 
                "Ihre Sitzung läuft in 10 Sekunden ab.", 
                "Sitzung verlängern", 
                () => {
                    // Reset the timer when user clicks the action button
                    resetInactivityTimer();
                }
            );
        }, sessionTimeout - warningTime);
        
        inactivityTimer = setTimeout(() => {
            // Show final toast before redirecting
            showToast("Session abgelaufen", "Sie werden zur Startseite weitergeleitet...");
            
            // Redirect after a short delay
            setTimeout(() => {
                window.location.href = '{{ path("catering_kassa_index") }}';
            }, 2000);
        }, sessionTimeout);
    }
    
    // Reset timer on any activity
    ['mousedown', 'mousemove', 'keypress', 'scroll', 'touchstart', 'click'].forEach(event => {
        document.addEventListener(event, resetInactivityTimer, true);
    });
    
    // Start the session timeout timer
    resetInactivityTimer();
    
    function updateCart() {
        let total = 0;
        let count = 0;
        
        // Update product rows and calculate totals
        document.querySelectorAll('.product-row').forEach(row => {
            const productId = row.dataset.productId;
            const price = parseInt(row.dataset.price);
            const quantity = cart[productId] || 0;
            const quantitySpan = row.querySelector('.quantity');
            
            quantitySpan.textContent = quantity;
            
            // Update row appearance
            if (quantity > 0) {
                row.classList.add('table-success');
            } else {
                row.classList.remove('table-success');
            }
            
            // Update decrease button state
            const decreaseBtn = row.querySelector('.btn-decrease');
            decreaseBtn.disabled = quantity <= 0;
            
            total += price * quantity;
            count += quantity;
        });
        
        // Update cart summary
        // document.getElementById('cart-total').textContent = (total / 100).toFixed(2) + ' €';
        document.getElementById('cart-count').textContent = count;
        
        // Update checkout button
        const checkoutBtn = document.getElementById('checkout-btn');
        if (count === 0) {
            checkoutBtn.disabled = true;
            checkoutBtn.innerHTML = '<i class="fas fa-shopping-cart" style="margin-right: 15px;"></i>Jetzt kaufen';
        } else {
            // Always allow checkout regardless of balance
            checkoutBtn.disabled = false;
            checkoutBtn.innerHTML = '<i class="fas fa-shopping-cart" style="margin-right: 15px;"></i>Jetzt kaufen (' + (total / 100).toFixed(2) + ' €)';
            checkoutBtn.style.background = 'linear-gradient(45deg, #28a745, #20c997)';
        }
    }
    
    // Handle quantity changes
    document.addEventListener('click', function(e) {
        if (e.target.classList.contains('btn-increase')) {
            const row = e.target.closest('.product-row');
            const productId = row.dataset.productId;
            cart[productId] = (cart[productId] || 0) + 1;
            updateCart();
        } else if (e.target.classList.contains('btn-decrease')) {
            const row = e.target.closest('.product-row');
            const productId = row.dataset.productId;
            if (cart[productId] > 0) {
                cart[productId] = cart[productId] - 1;
                if (cart[productId] === 0) {
                    delete cart[productId];
                }
                updateCart();
            }
        }
    });
    
    // Handle checkout
    document.getElementById('checkout-btn').addEventListener('click', function() {
        if (this.disabled) return;
        
        if (Object.keys(cart).length === 0) {
            alert('Bitte wähle mindestens ein Produkt aus.');
            return;
        }
        
        // Create form data
        const formData = new FormData();
        Object.keys(cart).forEach(productId => {
            formData.append('cart[' + productId + ']', cart[productId]);
        });
        
        // Show loading state
        this.disabled = true;
        this.innerHTML = '<i class="fas fa-spinner fa-spin" style="margin-right: 15px;"></i>Wird verarbeitet...';
        
        // Submit checkout
        fetch('{{ path("catering_kassa_checkout", {userId: user.uuid}) }}', {
            method: 'POST',
            body: formData
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                // Redirect directly to the confirmation page
                if (data.redirect) {
                    window.location.href = data.redirect;
                }
            } else {
                alert('Fehler: ' + data.message);
                updateCart(); // Reset button state
            }
        })
        .catch(error => {
            alert('Fehler bei der Bestellung: ' + error.message);
            updateCart(); // Reset button state
        });
    });
    
    // Initial cart update
    updateCart();
});
</script>
{% endblock %}
