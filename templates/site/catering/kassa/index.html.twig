{% extends 'site/catering/kassa/base.html.twig' %}

{% block title %}Willkommen - KaiserLAN Kassa{% endblock %}

{% block content %}
<div class="text-center">
    <div style="margin-bottom: 40px;">
        <i class="fas fa-qrcode" style="font-size: 8rem; color: #007be6; margin-bottom: 30px;"></i>
        <p style="color: #666; font-size: 1.6rem; margin-bottom: 40px;">
            Scanne deinen QR-Code vom Armband <br />
            oder Handy um zu starten
        </p>
    </div>
    
    <div style="max-width: 400px; margin: 0 auto;">
        <a href="{{ path('catering_kassa_scan') }}" class="btn-kassa" style="width: 100%; margin-bottom: 20px;">
            <i class="fas fa-play-circle" style="margin-right: 15px; font-size: 2rem;"></i>
            Jetzt scannen
        </a>
        
        <div style="margin-top: 40px; padding-top: 30px; border-top: 2px solid #eee;">
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px;">
                <div style="text-align: center;">
                    <i class="fas fa-mobile-alt" style="font-size: 2rem; color: #28a745; margin-bottom: 10px;"></i>
                    <p style="color: #666; font-size: 1rem; margin: 0;">QR-Code am<br>Smartphone</p>
                </div>
                <div style="text-align: center;">
                    <i class="fas fa-id-card" style="font-size: 2rem; color: #17a2b8; margin-bottom: 10px;"></i>
                    <p style="color: #666; font-size: 1rem; margin: 0;">QR-Code am<br>Armband</p>
                </div>
            </div>
            <p style="color: #999; font-size: 0.9rem; text-align: center;">
                <i class="fas fa-shield-alt"></i>
                Sichere und schnelle Abwicklung
            </p>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Add some interactive feedback
    const startButton = document.querySelector('.btn-kassa');
    
    startButton.addEventListener('mouseenter', function() {
        this.style.transform = 'translateY(-3px) scale(1.02)';
    });
    
    startButton.addEventListener('mouseleave', function() {
        this.style.transform = '';
    });
    
    // Simple inactivity timeout for kiosk mode
    let inactivityTimer;
    
    function resetInactivityTimer() {
        clearTimeout(inactivityTimer);
        inactivityTimer = setTimeout(() => {
            // In kiosk mode, just refresh the page to clear any temporary data
            window.location.reload();
        }, 10 * 60 * 1000); // 10 minutes for start page
    }
    
    // Reset timer on any activity
    ['mousedown', 'mousemove', 'keypress', 'scroll', 'touchstart', 'click'].forEach(event => {
        document.addEventListener(event, resetInactivityTimer, true);
    });
    
    resetInactivityTimer();
});
</script>
<style>
    .btn-kassa {
        animation: pulse 2s infinite;
    }
    
    @keyframes pulse {
        0% {
            box-shadow: 0 4px 15px rgba(40, 167, 69, 0.3);
        }
        50% {
            box-shadow: 0 8px 25px rgba(40, 167, 69, 0.6);
            transform: translateY(-1px);
        }
        100% {
            box-shadow: 0 4px 15px rgba(40, 167, 69, 0.3);
        }
    }
</style>
{% endblock %}
