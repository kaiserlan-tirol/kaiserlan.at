{% extends 'site/catering/kassa/base.html.twig' %}

{% block title %}Pizza bestellen - KaiserLAN Kassa{% endblock %}
{% block header %}{% endblock %}

{% block content %}
<!-- User info header -->
<div style="background: linear-gradient(135deg, rgb(0, 123, 230) 0%,#4dacff 100%); color: white; padding: 20px; border-radius: 15px; margin-bottom: 30px; text-align: center;">
    <h3 style="margin: 0; font-size: 1.8rem; display: flex; align-items: center; justify-content: space-between;">
      <span>
        <i class="fas fa-pizza-slice" style="margin-right: 10px;"></i>
        Pizzabestellung für {{ user.nickname }}
        </span>
        <span style="margin: 0; font-size: 1.2rem; opacity: 0.9;">
            <i class="fas fa-wallet" style="margin-right: 8px;"></i>
            Guthaben: <strong>{{ (current_credit/100) | format_currency('EUR') }}</strong>
        </span>
    </h3>
</div>

{% include 'site/catering/_pizza_form.html.twig' with {
    back_url: path('catering_kassa_products', {userId: user.uuid}),
    back_label: 'Zurück zu den Produkten'
} %}

<style>
#cart-summary {
    margin: 0 -30px -30px -30px;
    border-radius: 15px 15px 0 0;
}
</style>
{% endblock %}
