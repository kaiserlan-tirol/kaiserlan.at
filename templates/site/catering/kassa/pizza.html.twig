{% extends 'site/catering/kassa/base.html.twig' %}

{% block title %}Pizza bestellen - KaiserLAN Kassa{% endblock %}
{% block header %}{% endblock %}

{% block content %}
<div class="mb-4" style="background: linear-gradient(135deg, rgb(0, 123, 230) 0%, #4dacff 100%); color: white; padding: 20px; border-radius: 15px;">
    <div class="d-flex justify-content-between align-items-center">
        <h3 class="mb-0">
            <i class="fas fa-user-circle"></i>
            {{ user.nickname }}
        </h3>
        <span>
            <i class="fas fa-wallet"></i>
            Guthaben: <strong>{{ (current_credit / 100)|format_currency('EUR') }}</strong>
        </span>
    </div>
</div>

<h1>Pizza bestellen</h1>
{% include 'site/catering/_pizza_form.html.twig' %}

<div class="mt-3">
    <a href="{{ path('catering_kassa_products', {userId: user.uuid}) }}" class="btn-kassa btn-kassa-secondary">
        <i class="fas fa-arrow-left"></i>
        Zurück zu den Produkten
    </a>
</div>
{% endblock %}
