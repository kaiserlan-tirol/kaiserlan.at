<div class="alert alert-info">
    <i class="fas fa-info-circle"></i>
    Pizzabestellungen sind bis Samstag, {{ deadline|date('H') }}:00 möglich. Beim Speichern wird eine bestehende Auswahl ersetzt.
</div>

<form method="post" action="{{ action }}" id="pizza-order-form">
    <input type="hidden" name="_token" value="{{ csrf_token('pizza_order') }}">
    <div class="card">
        <div class="card-header">
            <h5>Verfügbare Pizzen</h5>
        </div>
        <div class="card-body">
            <div class="row">
                {% for index, pizza in pizzas %}
                    <div class="col-md-6 mb-3">
                        <div class="card h-100">
                            <div class="card-body">
                                <h6 class="card-title">{{ pizza.name }}</h6>
                                {% if pizza.description %}
                                    <p class="card-text">{{ pizza.description }}</p>
                                {% endif %}
                                <div class="d-flex justify-content-between align-items-center">
                                    <strong>{{ (pizza.price / 100)|format_currency('EUR') }}</strong>
                                    <input
                                        type="number"
                                        name="cart[{{ index }}]"
                                        value="{{ selection[index]|default(0) }}"
                                        min="0"
                                        class="form-control text-center pizza-quantity"
                                        data-price="{{ pizza.price }}"
                                        style="width: 80px;"
                                    >
                                </div>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
        <div class="card-footer">
            <div class="d-flex justify-content-between align-items-center">
                <strong>Gesamtbetrag: <span id="pizza-total-amount">0,00 €</span></strong>
                <button type="submit" class="btn btn-primary btn-lg">
                    <i class="fas fa-pizza-slice"></i>
                    Pizzabestellung speichern
                </button>
            </div>
        </div>
    </div>
</form>

<script>
document.addEventListener('DOMContentLoaded', function() {
    function updatePizzaTotal() {
        let total = 0;
        document.querySelectorAll('#pizza-order-form .pizza-quantity').forEach(function(input) {
            const quantity = parseInt(input.value) || 0;
            const price = parseInt(input.dataset.price) || 0;
            total += quantity * price;
        });
        document.getElementById('pizza-total-amount').textContent = (total / 100).toFixed(2).replace('.', ',') + ' €';
    }

    document.querySelectorAll('#pizza-order-form .pizza-quantity').forEach(function(input) {
        input.addEventListener('input', updatePizzaTotal);
        input.addEventListener('change', updatePizzaTotal);
    });
    document.getElementById('pizza-order-form').addEventListener('submit', function() {
        this.querySelector('button[type="submit"]').disabled = true;
    });
    updatePizzaTotal();
});
</script>
