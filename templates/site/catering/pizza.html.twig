{% extends 'site/siteBase.html.twig' %}

{% block title %}Pizza bestellen{% endblock %}

{% block main %}
<div class="container">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <h1>Pizza bestellen</h1>

            {% include 'site/catering/_pizza_form.html.twig' with {
                back_url: path('catering_credit'),
                back_label: 'Zurück zur Übersicht'
            } %}
        </div>
    </div>
</div>

<style>
.btn-kassa {
    background: linear-gradient(45deg, #28a745, #20c997);
    border: none;
    color: white;
    font-size: 1.5rem;
    padding: 15px 20px;
    border-radius: 15px;
    cursor: pointer;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    box-shadow: 0 4px 15px rgba(40, 167, 69, 0.3);
}

.btn-kassa i {
    margin-right: 10px;
}

.btn-kassa:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(40, 167, 69, 0.4);
    color: white;
    text-decoration: none;
}

.btn-kassa:active {
    transform: translateY(0);
}

.btn-kassa:disabled {
    opacity: 0.65;
    cursor: not-allowed;
    transform: none;
}

.btn-kassa-secondary {
    background: linear-gradient(45deg, #6c757d, #495057);
    box-shadow: 0 4px 15px rgba(108, 117, 125, 0.3);
}

.btn-kassa-secondary:hover {
    box-shadow: 0 8px 25px rgba(108, 117, 125, 0.4);
}

.kassa-navigation {
    display: flex;
    justify-content: space-between;
    gap: 20px;
}
</style>
{% endblock %}
